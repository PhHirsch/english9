/* English 9 – Login, Münzen, Avatar (gemeinsam für alle Spiele) */
(function () {
  // Web-App-URL aus Google Apps Script (Bereitstellung). Leer = ohne Login.
  const API_URL = "/*API_URL*/";

  const CATALOG = /*CATALOG*/;
  const SLOTS = ["skin", "eyes", "lashes", "face", "hairstyle", "haircolor", "top", "hat", "glasses", "jewellery", "extra", "aura", "bg"];
  const TABS = [["Face", ["skin", "eyes", "lashes", "face"]], ["Hair", ["hairstyle", "haircolor"]], ["Clothes", ["top"]], ["Hats", ["hat"]], ["Glasses", ["glasses"]], ["Jewellery", ["jewellery"]], ["Extras", ["extra", "aura"]], ["Backgrounds", ["bg"]]];
  const SLOTNAME = { skin: "Skin tone", eyes: "Eyes", lashes: "Eye shape", face: "Face paint & stickers", hairstyle: "Hairstyle", haircolor: "Hair colour", top: "Clothes", hat: "Hats", glasses: "Glasses", jewellery: "Jewellery", extra: "Pets & gadgets", aura: "Aura", bg: "Backgrounds" };
  const DEFAULT = { skin: "skin2", eyes: "eye-brown", lashes: "lash-off", face: "face-none", hairstyle: "hs-short", haircolor: "hc-brown", top: "top-tshirt-white", hat: "hat-none", glasses: "gl-none", jewellery: "jw-none", extra: "ex-none", aura: "aura-none", bg: "bg-plain" };
  const LEVEL_XP = [0, 50, 120, 220, 350, 500, 700, 950, 1250, 1600, 2000, 2500];
  const LEVEL_NAMES = ["", "Rookie", "Rookie", "Explorer", "Explorer", "Pro", "Pro", "Master", "Master", "Legend", "Legend", "Legend+"];
  const ACTIVE_UNITS = /*UNITS*/;
  const SKEY = "e9session", MAXAGE = 90 * 60 * 1000;

  function getSession() {
    try {
      const s = JSON.parse(sessionStorage.getItem(SKEY));
      if (s && Date.now() - s.t < MAXAGE) return s;
      sessionStorage.removeItem(SKEY);
    } catch (e) {}
    return null;
  }
  function setSession(s) { s.t = Date.now(); try { sessionStorage.setItem(SKEY, JSON.stringify(s)); } catch (e) {} }
  function logout() { try { sessionStorage.removeItem(SKEY); } catch (e) {} }

  async function api(action, data) {
    if (!API_URL || API_URL.indexOf("/*") === 0) return { ok: false, error: "offline" };
    try {
      const r = await fetch(API_URL, { method: "POST", body: JSON.stringify(Object.assign({ action: action }, data)) });
      return await r.json();
    } catch (e) { return { ok: false, error: "network" }; }
  }
  async function login(nr, pin) {
    const r = await api("login", { nr: String(nr).trim(), pin: String(pin).trim() });
    if (r.ok) setSession({ nr: String(nr).trim(), pin: String(pin).trim(), state: r.state });
    return r;
  }
  async function setPin(newpin) {
    const s = getSession();
    if (!s) return { ok: false, error: "nologin" };
    const r = await api("setpin", { nr: s.nr, pin: s.pin, newpin: String(newpin).trim() });
    if (r.ok) { s.pin = String(newpin).trim(); s.state = r.state; setSession(s); }
    return r;
  }
  async function call(action, extra) {
    const s = getSession();
    if (!s) return { ok: false, error: "nologin" };
    const r = await api(action, Object.assign({ nr: s.nr, pin: s.pin }, extra || {}));
    if (r.ok && r.state) { s.state = r.state; setSession(s); }
    if (r.error === "login" || r.error === "locked") logout();
    return r;
  }
  function errText(e) {
    return ({
      offline: "Login is not set up yet. – Login ist noch nicht eingerichtet.",
      network: "No connection. Try again. – Keine Verbindung, versuch es nochmal.",
      login: "Wrong number or PIN. – Nummer oder PIN falsch.",
      locked: "Too many wrong tries. Wait 5 minutes. – Zu viele Fehlversuche, warte 5 Minuten.",
      coins: "Not enough coins. – Nicht genug Münzen.",
      nologin: "Please log in on the start page. – Bitte auf der Startseite anmelden.",
      server: "Server error. Try again. – Serverfehler, versuch es nochmal.",
      weakpin: "This PIN is too easy to guess. Choose another one. – Diese PIN ist zu leicht zu erraten.",
      samepin: "Choose a new PIN, not the old one. – Wähle eine neue PIN, nicht die alte.",
      pinmatch: "The two PINs are not the same. – Die beiden PINs sind nicht gleich.",
      level: "You need a higher level for this. – Dafür brauchst du ein höheres Level."
    })[e] || ("Error: " + e);
  }

  /* Ergebnis am Ende eines Spiels melden und anzeigen */
  function reportInto(elId, game, S, save) {
    const box = document.getElementById(elId);
    if (!box) return;
    if (!API_URL || API_URL.indexOf("/*") === 0) { box.style.display = "none"; return; }
    const se = getSession();
    const prevLevel = se && se.state ? se.state.level : 0;
    const show = r => {
      let t = `<div style="font-size:24px;font-weight:700">+${r.earned} 🪙</div>`;
      t += `<div>${"⭐".repeat(r.stars)}${"☆".repeat(3 - r.stars)} · You have <b>${r.state.coins} 🪙</b> now.</div>`;
      if (!r.first && !r.improved && !r.daily) t += `<div style="font-size:14px;opacity:.75">Played before: fewer coins. Get more stars for more coins! – Wiederholung: weniger Münzen, mehr Sterne bringen mehr.</div>`;
      if (r.improved) t += `<div style="font-size:14px;opacity:.75">New best! – Neuer Rekord!</div>`;
      if (r.daily && !r.earned) t += `<div style="font-size:14px;opacity:.75">Daily coins only once a day. – Tagesmünzen gibt es nur 1x pro Tag.</div>`;
      if (prevLevel && r.state.level > prevLevel) t += `<div style="font-size:22px;font-weight:800;margin-top:6px">🎉 LEVEL UP! Level ${r.state.level}</div>`;
      box.innerHTML = t;
    };
    if (!se) { box.innerHTML = "🪙 Log in on the start page to earn coins. <div style='font-size:14px;opacity:.75'>Melde dich auf der Startseite an, um Münzen zu sammeln.</div>"; return; }
    if (S.reportedResult) { show(S.reportedResult); return; }
    box.textContent = "Saving your coins … 🪙";
    call("result", { game: game, mistakes: S.mistakes, secs: S.end && S.start ? Math.round((S.end - S.start) / 1000) : 0, total: S.total || 0 }).then(r => {
      if (r.ok) { S.reportedResult = r; save(); show(r); }
      else box.innerHTML = "⚠️ " + errText(r.error) + " <button onclick='location.reload()' style='font-size:16px'>Try again</button>";
    });
  }

